{
  "$schema": "https://acontrollayer.com/schemas/pvs-1.schema.json",
  "description": "Test vectors for PVS-1 schema validation",
  "vectors": [
    {
      "id": "pvs-valid-approved",
      "description": "Valid approved verdict with all fields",
      "valid": true,
      "data": {
        "version": "pvs-1",
        "decision": "allow",
        "approved": true,
        "reasoning": "All policies satisfied.",
        "policy_violations": [],
        "confidence_score": 0.99,
        "policy_set": ["Policy A", "Policy B"],
        "metadata": {
          "engine": "the-sentry",
          "latency_ms": 100
        }
      }
    },
    {
      "id": "pvs-valid-rejected",
      "description": "Valid rejected verdict with violations",
      "valid": true,
      "data": {
        "version": "pvs-1",
        "decision": "deny",
        "approved": false,
        "reasoning": "Policy violation detected.",
        "policy_violations": ["Policy A"],
        "confidence_score": 0.95
      }
    },
    {
      "id": "pvs-valid-minimal",
      "description": "Valid verdict with only required fields",
