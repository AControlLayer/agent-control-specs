{
  "id": "AIP-1",
  "oidBase": "1.3.6.1.4.1.59999.1",
  "certificateLifetime": {
    "maximumMinutes": 15,
    "recommendedMinutes": 5,
    "issuerBackdateMinutes": {
      "minimum": 1,
      "maximum": 2
    },
    "verifierGraceSeconds": 60,
    "maximumClockDriftSeconds": 30
  },
  "extensions": [
    {
      "constant": "VERSION",
      "suffix": 1,
      "name": "AIP-Version",
      "dataType": "INTEGER",
      "example": "1",
      "valueSchema": {
        "type": "integer",
        "const": 1,
        "description": "MUST equal the AIP protocol version 1."
      },
      "description": "Protocol version (e.g., `1`)."
    },
    {
      "constant": "ROLE",
      "suffix": 2,
      "name": "Agent-Role",
      "dataType": "UTF8String",
      "example": "researcher",
      "valueSchema": {
        "type": "string",
        "minLength": 1,
        "description": "MUST be a non-empty semantic role name."
      },
      "description": "Semantic role (e.g., `researcher`, `market-maker`)."
    },
    {
      "constant": "TENANT_ID",
      "suffix": 3,
      "name": "Tenant-ID",
      "dataType": "UTF8String",
      "example": "00000000-0000-4000-8000-000000000123",
      "valueSchema": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "description": "MUST be a canonical UUID tenant identifier."
      },
      "description": "The UUID of the owner/tenant (`tenant_id`)."
    },
    {
      "constant": "CAPABILITIES",
      "suffix": 4,
      "name": "Capability-Set",
      "dataType": "IA5String",
      "example": "[\"agent:researcher\",\"perm:files:read\"]",
      "valueSchema": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "format": "ctx-1-capability"
        },
        "description": "MUST be a JSON array of unique CTX-1-conformant capability strings; unknown prefixes remain valid and are ignored by consumers that do not understand them."
      },
      "description": "JSON array of approved capabilities (e.g., `[\"perm:files:read\", \"agent:trade:execute\"]`)."
    },
    {
      "constant": "ANCHOR_CHAIN",
      "suffix": 5,
      "name": "Anchor-Chain",
      "dataType": "UTF8String",
      "example": "ethereum:sepolia",
      "valueSchema": {
        "type": "string",
        "minLength": 1,
        "description": "MUST be a non-empty trust-anchor chain identifier."
      },
      "description": "Blockchain used for Root Trust (e.g., `ethereum:sepolia`)."
    },
    {
      "constant": "AUDIENCE",
      "suffix": 6,
      "name": "AIP-Audience",
      "dataType": "UTF8String",
      "example": "api.example.com",
      "valueSchema": {
        "type": "string",
        "minLength": 1,
        "description": "MUST be a non-empty intended verifier identifier."
      },
      "description": "Intended verifier / audience (e.g., `api.acme.com`)."
    },
    {
      "constant": "ENVIRONMENT",
      "suffix": 7,
      "name": "AIP-Environment",
      "dataType": "UTF8String",
      "example": "production",
      "valueSchema": {
        "type": "string",
        "minLength": 1,
        "description": "MUST be a non-empty deployment environment name."
      },
      "description": "Deployment environment (`production`, `staging`, `development`, etc.)."
    }
  ],
  "conformance": {
    "levels": [
      {
        "level": 1,
        "name": "Core",
        "enforceMaximumLifetime": true,
        "enforceMaximumClockDrift": false,
        "requiredExtensions": ["VERSION", "TENANT_ID", "CAPABILITIES"],
        "conditionalExtensions": [],
        "validateExtensions": [],
        "additionalRequirements": [
          "Validate certificate signatures and expiration"
        ]
      },
      {
        "level": 2,
        "name": "Extended",
        "enforceMaximumLifetime": false,
        "enforceMaximumClockDrift": true,
        "requiredExtensions": ["ENVIRONMENT"],
        "conditionalExtensions": [
          {
            "constant": "AUDIENCE",
            "condition": "certificates are scoped"
          }
        ],
        "validateExtensions": ["ENVIRONMENT"],
        "additionalRequirements": []
      },
      {
        "level": 3,
        "name": "Complete",
        "enforceMaximumLifetime": false,
        "enforceMaximumClockDrift": false,
        "requiredExtensions": [],
        "conditionalExtensions": [],
        "validateExtensions": [],
        "additionalRequirements": [
          "Anchor Root CA to blockchain",
          "Support on-chain verification of Root CA fingerprint",
          "Implement full CTX-1 capability vocabulary"
        ]
      }
    ]
  }
}
