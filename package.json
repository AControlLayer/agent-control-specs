{
  "name": "@acontrollayer/spec-contracts",
  "version": "1.2.0",
  "description": "Canonical machine-readable contracts for the AControlLayer public specifications",
  "type": "module",
  "license": "MIT",
  "files": [
    "contracts",
    "schemas",
    "examples"
  ],
  "exports": {
    ".": "./contracts/registry.json",
    "./registry": "./contracts/registry.json",
    "./aip-1": "./contracts/aip-1.json",
    "./ctx-1": "./contracts/ctx-1.json",
    "./schemas/adp-1": "./schemas/adp-1.schema.json",
    "./schemas/pvs-1": "./schemas/pvs-1.schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check:contract-docs": "node scripts/check-contract-docs.mjs",
    "write:contract-docs": "node scripts/check-contract-docs.mjs --write",
    "check": "node --test tests/*.test.mjs && node scripts/check-contract-docs.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
